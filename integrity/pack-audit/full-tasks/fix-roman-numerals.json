  "controls": [
    {
      "name": "missing_xc_substitution",
      "kind": "known_bad",
      "description": "A string-expansion implementation (expand each subtractive pair to its additive equivalent, then sum digit-by-digit) that omits the XC -> LXXXX expansion rule -- a realistic oversight since 90 is the least memorable of the six subtractive pairs. XC (90) is summed as X+C=110 instead, and MCMXCIV -- which contains an embedded XC -- comes out 20 too high (2014 instead of 1994). All other subtractive pairs (IV, IX, XL, CD, CM) are handled correctly.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.7777777777777778,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_xc', 'test_mcmxciv']"
    },
    {
      "name": "off_by_one_comparison",
      "kind": "known_bad",
      "description": "Forward-scanning implementation that uses <= instead of < when deciding whether the current numeral is smaller than its neighbor, so two adjacent numerals of EQUAL value are wrongly treated as a subtractive pair and cancel out instead of adding (III -> -1, LVIII -> 54). A very plausible off-by-one when writing the lookahead comparison. Standard non-repeating subtractive forms like IV/IX still come out correct, so this control is only caught by the repeated-numeral hidden tests.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.7777777777777778,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_iii', 'test_lviii']"
    },
    {
      "name": "transposed_pair_typo",
      "kind": "known_bad",
      "description": "A pair-lookup implementation with a realistic copy/paste typo: the two-letter keys for 9 and 900 are transposed (\"XI\" instead of \"IX\", \"MC\" instead of \"CM\"), so the actual subtractive forms IX and CM never match the table and fall through to plain digit summation (IX -> 11, CM -> 1100). Correct for the other four subtractive pairs (IV, XL, XC, CD). The hidden suite's direct IX/CM/MCMXCIV tests must reject this.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.7777777777777778,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_ix', 'test_cm']"
    },
    {
      "name": "forward_lookahead",
      "kind": "alternative",
      "description": "Structurally different but behaviorally equivalent correct solution: scans left-to-right with one character of lookahead (subtract the current numeral if the NEXT one is strictly larger, else add it), instead of the reference's right-to-left scan that tracks the largest value seen so far (prev). Different iteration direction, different loop state; produces identical results for every well-formed Roman numeral (the two approaches only diverge on malformed/ambiguous strings outside the task's spec, e.g. \"IIX\").",
      "expected_accept": true,
      "verdict": "accepted",
      "final_score": 1.0,
      "functional_pass": true,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=accepted"
    }
  ],
