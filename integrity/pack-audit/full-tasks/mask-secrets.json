  "controls": [
    {
      "name": "bearer_quantifier_reversed",
      "kind": "known_bad",
      "description": "Misreads 'a token of 8 or more characters' as 'a token of up to 8 characters' and uses {1,8} instead of {8,}. Only the first 8 characters of a longer bearer token get swept into the match, so the tail of the credential (e.g. '1234' in 'abcdefgh1234') is left in the output.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.8571428571428571,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_masks_whole_bearer_credential_not_just_token']"
    },
    {
      "name": "bearer_token_partial_mask",
      "kind": "known_bad",
      "description": "Uses a lookbehind so only the token after 'Bearer ' is replaced, leaving the literal word 'Bearer' visible in the output instead of redacting the whole 'Bearer <token>' credential as the spec requires.",
