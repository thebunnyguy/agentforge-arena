    },
    {
      "name": "substring_dotdot",
      "kind": "known_bad",
      "description": "Rejects '..' as a raw substring anywhere in the name instead of checking it as a whole path component. This is a realistic off-by-one on the spec: it correctly rejects traversal like '../etc/passwd', but it ALSO wrongly rejects legitimate filenames that merely contain '..', such as 'safe..file' or 'my..report.txt', which the task explicitly requires to be returned unchanged.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.9230769230769231,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_inner_dots_allowed']"
    },
    {
      "name": "posix_separator_only",
      "kind": "semantic_mutant",
      "description": "Security-relevant near-miss: uses os.sep/os.altsep to detect path separators instead of literal '/' and '\\\\'. On a POSIX grading host, os.sep is '/' and os.altsep is None, so a backslash is never recognized as a separator and 'a\\\\b' (or a Windows-style traversal payload like '..\\\\..\\\\secret') is accepted unchanged instead of being rejected. A partial or platform-naive fix for path-separator rejection is realistically likely to make exactly this mistake.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.9230769230769231,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_backslash_separator_raises']"
    },
    {
      "name": "regex_single_check",
      "kind": "alternative",
      "description": "Structurally different but behaviorally equivalent correct solution: uses a single compiled regex character class to detect any of the separator/null-byte characters in one pass, combined with a set membership check for '.'/'..', instead of the reference's sequential if-statements plus a split-into-components loop. Since any '/' or '\\\\' is already rejected outright, the only reachable way for a '..' path component to occur is when the whole name equals '..', so the component-split step is provably redundant and this single-regex form is fully equivalent for all inputs.",
      "expected_accept": true,
      "verdict": "accepted",
      "final_score": 1.0,
      "functional_pass": true,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=accepted"
    }
