    {
      "name": "lowercase_and_joiner",
      "kind": "known_bad",
      "description": "WHERE conditions are joined with lowercase ' and ' instead of the contract-required ' AND '. Column joining, the WHERE/LIMIT omission rules, and the 'SELECT *' default are otherwise correct. A realistic casing slip an agent might make by treating SQL keywords as case-insensitive rather than copying the contract's literal 'AND'.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.7777777777777778,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_full_example', 'test_two_wheres_and_joined']"
    },
    {
      "name": "missing_comma_space",
      "kind": "known_bad",
      "description": "Column list is joined with a bare comma (\",\") instead of \", \" (comma + space). WHERE/LIMIT clauses and the AND-joining are otherwise correct. A realistic transcription slip when an agent hand-writes the join separator instead of copying the contract's exact ', ' literal.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.7777777777777778,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_full_example', 'test_limit_without_where']"
    },
    {
      "name": "select_star_forgets_clauses",
      "kind": "known_bad",
      "description": "Control-flow bug: build() branches early on the 'no columns selected' case and returns bare 'SELECT *' without ever appending accumulated WHERE/LIMIT clauses, because the append logic for WHERE/LIMIT was written only inside the 'if self._columns' branch. Columns-present path, AND-joining, and comma-joining are all correct. A realistic bug from writing the two SELECT-clause branches as independent early returns instead of building the SELECT prefix first and always falling through to the shared WHERE/LIMIT logic.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.7777777777777778,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_select_star_still_appends_where_and_limit', 'test_where_called_with_empty_condition_still_emits_where']"
    },
    {
      "name": "empty_where_condition_dropped",
      "kind": "semantic_mutant",
      "description": "where(condition) only records the condition when it is truthy, silently dropping a call made with an empty string. The contract says the WHERE clause is appended 'if at least one where() was called' -- that's a call-count rule, not a truthiness-of-the-argument rule -- so where(\"\") must still produce a (degenerate) WHERE clause. This mutant instead ends up omitting WHERE entirely in that case. A realistic near-miss from an agent adding a defensive 'if condition:' guard before appending, assuming (wrongly, per this contract) that an empty condition means 'no condition'.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.8888888888888888,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_where_called_with_empty_condition_still_emits_where']"
    },
