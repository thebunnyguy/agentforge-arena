  "controls": [
    {
      "name": "first_dependency_only",
      "kind": "known_bad",
      "description": "Realistic incomplete-loop bug: only the FIRST dependency in each node's dependency list is wired into the graph; any additional dependencies in the same list are silently ignored (e.g. written as `deps[0]` instead of iterating the whole list). Cycle detection and lexicographic tiebreaks are otherwise implemented correctly. This is exactly the failure mode the hidden test_multiple_implicit_dependencies docstring calls out ('an impl that registers only the FIRST implicit dep of each list misses core').",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.9230769230769231,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_multiple_implicit_dependencies']"
    },
    {
      "name": "insertion_order_tiebreak",
      "kind": "known_bad",
      "description": "Realistic tiebreak bug: dependency ordering and cycle detection are both correct (BFS/Kahn-style with a FIFO queue), but ties between simultaneously-eligible nodes are broken by first-seen/insertion order while scanning the graph, instead of the required lexicographic order. This is the kind of mistake an agent makes by reaching for a plain queue instead of noticing the spec's determinism requirement. The hidden exact-order tests must reject this.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.8461538461538461,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_independent_nodes_sorted_lexicographically', 'test_tiebreak_prefers_lexicographic_among_eligible']"
    },
    {
      "name": "missing_cycle_check",
      "kind": "known_bad",
      "description": "Realistic 'forgot the edge case' bug: implements Kahn's algorithm correctly for acyclic graphs (min-heap over ready nodes for lexicographic tiebreaks) but never checks whether every node was actually emitted. On a cyclic graph the nodes stuck in the cycle simply never become ready and are silently dropped from the result instead of raising CycleError -- no infinite loop, just a shorter, wrong, non-exception return. The hidden cycle-detection tests must reject this.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.6923076923076923,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_cycle_raises', 'test_self_loop_raises', 'test_longer_cycle_raises', 'test_implicit_dependency_in_cycle_is_still_a_cycle']"
    },
    {
      "name": "dfs_postorder",
      "kind": "alternative",
      "description": "Behaviorally equivalent to the reference but structurally different: a depth-first postorder traversal with white/gray/black recursion-stack coloring for cycle detection, instead of the reference's Kahn's-algorithm BFS with a min-heap. Determinism is achieved by visiting the outer node loop and each node's dependency list in sorted (lexicographic) order rather than by a heap of ready nodes. Produces the same dependency-respecting, lexicographically tie-broken order as the reference on every graph shape exercised by the hidden suite.",
      "expected_accept": true,
      "verdict": "accepted",
      "final_score": 1.0,
      "functional_pass": true,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=accepted"
    }
  ],
  "findings": [
    {
      "finding_id": "protected_paths.pytest_shadow_package_nested",
      "category": "isolation",
      "severity": "info",
      "summary": "A `_pytest/` package nested inside this task's editable subtree is not flagged as a protected-path violation, but empirical testing confirms this is NOT currently exploitable.",
      "detail": "Injecting 'graphkit/_pytest/__init__.py' (nested inside the editable package, not at the snapshot root) was NOT flagged as touching a protected path \u2014 but `python -m pytest` never adds the editable package directory itself to sys.path, so this nested `_pytest/` is only importable as `<package>._pytest`, never as the bare top-level `_pytest` the real pytest package needs; a controlled test confirms `import _pytest` still resolves to the real site-packages module. Recorded as a structural gap (no basename/suffix rule catches a directory named `_pytest`) that would only matter if this task ever lost its editable_paths allow-list, not as a live weakness today. See docs/agents/ORACLE.md.",
      "evidence": {
        "probe_path": "graphkit/_pytest/__init__.py",
