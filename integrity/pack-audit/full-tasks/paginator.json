  "controls": [
    {
      "name": "boundary_flags_use_inclusive_comparison",
      "kind": "known_bad",
      "description": "num_pages and start_index/end_index are all correct, but has_previous and has_next are computed with the wrong comparison direction at the boundary: has_previous = (n >= 1) and has_next = (n <= num_pages). Since page() already guarantees 1 <= n <= num_pages for any page it returns, both conditions are trivially always True \u2014 so has_previous is wrongly True on the first page and has_next is wrongly True on the last page. A plausible confusion between 'is n a valid page number' (>=1 / <=num_pages) and 'is there a page before/after n' (>1 / <num_pages), especially since the two pairs of operators look almost identical.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.625,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_first_page_indices_and_flags', 'test_last_page_indices_and_flags', 'test_exact_multiple_num_pages_not_off_by_one']"
    },
    {
      "name": "num_pages_exact_multiple_off_by_one",
      "kind": "known_bad",
      "description": "num_pages is computed as total_items // per_page + 1 (the classic 'divide then add one for the remainder' mistake) instead of the correct ceiling (total_items + per_page - 1) // per_page. This coincidentally matches the correct ceiling for every total_items that is NOT an exact multiple of per_page, but reports one extra, entirely out-of-range page whenever total_items is an exact multiple of per_page (e.g. Paginator(9, 3) reports num_pages == 4 instead of 3, and .page(4) succeeds instead of raising). total_items == 0 is special-cased separately so this control isolates the exact-multiple behavior class rather than conflating it with the empty-collection case.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.875,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_exact_multiple_num_pages_not_off_by_one']"
    },
    {
      "name": "unclamped_end_index_last_page",
      "kind": "known_bad",
      "description": "num_pages, has_previous, and has_next are all correct, but end_index is computed as start_index + per_page with no clamp to total_items, so it assumes every page is full. Correct on every full page, but wrong on the final page whenever total_items is not an exact multiple of per_page (e.g. Paginator(10, 3).page(4).end_index comes out as 12 instead of 10) \u2014 a very plausible slip since the naive formula happens to work for interior pages and only breaks on the boundary the author was least likely to hand-check.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.875,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_last_page_indices_and_flags']"
    },
    {
      "name": "num_pages_floor_at_least_one",
      "kind": "semantic_mutant",
      "description": "Realistic near-miss specific to this task's contract: num_pages is computed as max(1, ceil(total_items / per_page)), mirroring a very common real-world pagination convention where an empty collection still reports one (empty) page rather than zero pages. This task's contract explicitly requires num_pages == 0 when total_items == 0 and .page(1) to raise ValueError in that case (num_pages is 0, so every page number is invalid) \u2014 this mutant instead reports num_pages == 1 for an empty collection and .page(1) succeeds, returning an empty page (start_index == end_index == 0) instead of raising. Everywhere total_items > 0 this mutant is behaviorally identical to a correct implementation.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.875,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_empty_collection_has_no_pages']"
    },
    {
      "name": "eager_page_bounds_list",
      "kind": "alternative",
      "description": "Structurally different but behaviorally equivalent correct implementation: instead of computing start_index/end_index/num_pages lazily from arithmetic on each .page(n) call, __init__ eagerly walks the collection once with a while-loop and precomputes a list of (start, end) bounds tuples, one entry per page (empty list when total_items == 0). num_pages becomes len(...) of that list and .page(n) just validates n and indexes into the precomputed list. Different data structure and control flow (upfront list-building vs. per-call arithmetic), same observable behavior including the num_pages == 0 / ValueError edge case.",
      "expected_accept": true,
      "verdict": "accepted",
      "final_score": 1.0,
      "functional_pass": true,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=accepted"
    }
