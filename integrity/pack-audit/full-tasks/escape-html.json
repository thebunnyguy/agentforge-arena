    },
    {
      "name": "missing_quotes_attribute_injection",
      "kind": "semantic_mutant",
      "description": "Security-relevant near-miss: fixes the headline bug the snapshot's BUG comment leads with (adds ampersand-first escaping of &, <, >) but stops short of adding quote escaping. Text-context XSS via <, > and & is prevented, but a value placed inside a quoted HTML attribute can still break out via an unescaped \" or ' and inject new attributes/handlers -- a naive fix that addresses only the most visible symptom.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.5555555555555556,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_escapes_double_quote', 'test_escapes_single_quote', 'test_combined_attribute_value', 'test_escapes_repeated_ampersands_and_brackets']"
    },
    {
      "name": "char_by_char_lookup",
      "kind": "alternative",
      "description": "Behaviorally equivalent to the reference but structurally different: instead of five sequential str.replace calls over the whole string (which requires careful ampersand-first ordering to avoid double-escaping), this builds the result by scanning the original string once, character by character, and looking each character up in a dict -- so it is naturally immune to the double-escaping ordering hazard rather than avoiding it by ordering. Should be ACCEPTED.",
      "expected_accept": true,
      "verdict": "accepted",
