  "controls": [
    {
      "name": "host_substring_match",
      "kind": "known_bad",
      "description": "Matches the host with substring containment (`allowed_host in hostname`) instead of exact equality. Wrongly accepts any host that merely contains the allowed host as a substring, e.g. 'app.example.com.evil.com' -- a domain the attacker fully controls, not just the allowed host itself. A realistic 'looks close enough' mistake when generalizing from a single-example fix.",
      "expected_accept": false,
      "verdict": "accepted",
      "final_score": 1.0,
      "functional_pass": true,
      "matched_expectation": false,
      "status": "fail",
      "notes": "verdict=accepted"
    },
    {
      "name": "protocol_relative_bypass",
      "kind": "known_bad",
      "description": "Checks only `not parsed.scheme` (instead of `not parsed.scheme and not parsed.netloc`) before treating a leading '/' as a safe relative path, and has no explicit pre-check for '//'. Since urlparse('//evil.com') yields an empty scheme, this wrongly classifies the protocol-relative target as relative and returns it unchanged -- a classic open-redirect bypass. Must be rejected by the hidden suite's protocol-relative test.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.9090909090909091,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_protocol_relative_raises']"
    },
    {
      "name": "scheme_blacklist",
      "kind": "known_bad",
      "description": "Validates the scheme with a blacklist of 'known dangerous' schemes (javascript, data) instead of an allow-list of 'known safe' ones (http, https). Any scheme not on the blacklist -- e.g. 'ftp:' -- slips through to the host check and is wrongly accepted when the host matches. A plausible mistake: fixing the two schemes named in a bug report without generalizing to an allow-list.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.9090909090909091,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_non_http_scheme_to_allowed_host_raises']"
    },
    {
      "name": "host_only_scheme_forgotten",
      "kind": "semantic_mutant",
      "description": "Security-relevant near-miss reproducing this task's original, since-fixed weakness: validates only the netloc/host and forgets to restrict the URL scheme to http/https. 'javascript://app.example.com/x' and 'data://app.example.com/x' parse with a netloc equal to the allowed host, so they pass the host check and are returned unchanged even though the scheme makes them executable/dangerous. A naive or partial fix that adds host validation without also adding scheme validation would produce exactly this.",
      "expected_accept": false,
      "verdict": "rejected_by_hidden_test",
      "final_score": 0.7272727272727273,
      "functional_pass": false,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=rejected_by_hidden_test; failing_hidden_tests=['test_hosted_javascript_scheme_raises', 'test_hosted_data_scheme_raises', 'test_non_http_scheme_to_allowed_host_raises']"
    },
    {
      "name": "allowlist_first_dispatch",
      "kind": "alternative",
      "description": "Legitimately different-but-correct implementation: classifies the target into relative-vs-absolute up front via a small predicate helper and a frozenset-based scheme allow-list, rather than the reference's sequential guard clauses. Different control flow and data structure, same accept/reject behavior. Should be ACCEPTED.",
      "expected_accept": true,
      "verdict": "accepted",
      "final_score": 1.0,
      "functional_pass": true,
      "matched_expectation": true,
      "status": "pass",
      "notes": "verdict=accepted"
    }
